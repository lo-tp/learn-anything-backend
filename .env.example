DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/learn_anything
PORT=8000
FRONTEND_DOMAIN=http://localhost:3000
SANDBOX_URL=http://localhost:8080
# Shared by the frontend and backend to sign/verify the 30-day sign-in token.
JWT_SECRET=
MAX_PROBE_QUESTIONS=10
MAX_MATERIAL_ATTEMPTS=3
MAX_SLIDE_SELF_REPAIR_TURNS=2
LOG_LEVEL=INFO

# --- How this app talks to a model --------------------------------------
# The endpoint. OPENAI_* are the OpenAI SDK's own names; LLM_MODEL is this app's.
OPENAI_API_KEY=
OPENAI_BASE_URL=
#LLM_MODEL=gpt-4o-mini
# MOCK_LLM runs the pre-material phases on a mock model and an in-memory DB
# (#118); the slide half still uses the real one, and no external search runs.
#MOCK_LLM=1

# The client. These are read once, at startup, because they belong to the client
# object rather than to a call: changing one means restarting the app. 120s is
# several times the slowest measured call, and a fraction of the SDK's 600s.
#LLM_REQUEST_TIMEOUT_SECONDS=120
#LLM_MAX_RETRIES=2

# Model-call knobs. Read per call, and named two ways: the plain name applies to
# every model call, NAME_<GRAPH>_<NODE> applies to one stage (plan.design_plan ->
# _PLAN_DESIGN_PLAN, material.write_slide -> _MATERIAL_WRITE_SLIDE), and the
# per-stage name wins. A value the backend would reject is logged and treated as
# unset. The stages are the table in core/reasoning.py plus the two slide calls.
#
# What a call may think, and how much it may write. Unset, both keep the measured
# per-stage budgets; set globally, REASONING_EFFORT is how you measure what
# thinking costs the whole app — and one stage gets put back afterwards with its
# own name (core/reasoning.py, graphs/material/sandbox.py).
#REASONING_EFFORT=low
#REASONING_EFFORT_MATERIAL_WRITE_SLIDE=minimal
#LLM_MAX_OUTPUT_TOKENS=8192
#LLM_MAX_OUTPUT_TOKENS_PLAN_RENDER_PLAN=8192
#
# How a call decodes (core/sampling.py). temperature, top_p, presence_penalty and
# frequency_penalty are standard chat-completion fields; top_k, min_p and
# repeat_penalty are not, and are sent nested in extra_body, which is how this
# project's llama.cpp backend reads them. Unset sends nothing, so a call keeps the
# defaults it had before — including the slide-writing ladder, which one of these
# replaces for every attempt when it is set.
#LLM_TEMPERATURE=0.7
#LLM_TOP_P=0.8
#LLM_TOP_K=40
#LLM_MIN_P=0.05
#LLM_REPEAT_PENALTY=1.05
#LLM_PRESENCE_PENALTY=0.0
#LLM_FREQUENCY_PENALTY=0.0
#LLM_TEMPERATURE_MATERIAL_WRITE_SLIDE=0.9
#LLM_TEMPERATURE_PROBE_EVALUATE_BATCH=0.2

# Shared with the Sandbox service for the internal /slides endpoint (#103).
SANDBOX_SERVICE_TOKEN=

# Web search for the plan graph's research step, through Tavily's MCP server
# (#166). Unset (or MOCK_LLM) means no external search: plans are built as
# before. Only the search tool is used; the hosted MCP URL is the default.
