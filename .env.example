DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/learn_anything
PORT=8000
FRONTEND_DOMAIN=http://localhost:3000
SANDBOX_URL=http://localhost:8080
# Shared by the frontend and backend to sign/verify the 30-day sign-in token.
JWT_SECRET=
MAX_PROBE_QUESTIONS=10
MAX_MATERIAL_ATTEMPTS=3
LOG_LEVEL=INFO

# Shared with the Sandbox service for the internal /slides endpoint (#103).
SANDBOX_SERVICE_TOKEN=

# Web search for the plan graph's research step, through Tavily's MCP server
# (#166). Unset (or MOCK_LLM) means no external search: plans are built as
# before. Only the search tool is used; the hosted MCP URL is the default.
TAVILY_API_KEY=
# TAVILY_MCP_URL=https://mcp.tavily.com/mcp/
