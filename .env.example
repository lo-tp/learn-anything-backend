DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/learn_anything
PORT=8000
FRONTEND_DOMAIN=http://localhost:3000
SANDBOX_URL=http://localhost:8080
# Shared by the frontend and backend to sign/verify the 30-day sign-in token.
JWT_SECRET=
MAX_PROBE_QUESTIONS=10
MAX_MATERIAL_ATTEMPTS=3
LOG_LEVEL=INFO

# Shared with the Sandbox service for the internal /slides endpoint (#103).
SANDBOX_SERVICE_TOKEN=

# Web search for the plan graph's research step, through Tavily's MCP server
# (#166). Unset (or MOCK_LLM) means no external search: plans are built as
# before. Only the search tool is used; the hosted MCP URL is the default.
TAVILY_API_KEY=
# TAVILY_MCP_URL=https://mcp.tavily.com/mcp/

# How much the model may think (#194). core/llm.py sets no reasoning_effort, so
# every call ran on the backend's default: 1544 completion tokens of which 6477
# characters were reasoning, for an answer asked for in a few hundred words.
# core/reasoning.py now bounds thinking per phase — off for the mechanical ones
# (rendering a plan, translating a label, writing slide contents), low for the
# judgement ones, high for research_topic, whose whole point is searching well.
# A phase is overridden per phase name (graph.node) and the slide calls are not
# overridable here; they take reasoning_effort from core/slide_generation.py.
# PHASE_REASONING_EFFORTS=clarify.assess_goal=medium,plan.design_plan=medium
# MAX_OUTPUT_TOKENS_PER_PHASE=plan.render_plan=1024

# A stalled request has to end (#194). Unset, the OpenAI SDK waits 600s and
# retries twice. This backend answers a normal call in seconds.
# LLM_REQUEST_TIMEOUT_SECONDS=120
# LLM_MAX_RETRIES=2

# A Tavily server that is down is asked again after this cooldown rather than on
# every plan request (#194); a plan without search is still a plan (#166).
# TAVILY_MCP_RETRY_COOLDOWN_SECONDS=60
